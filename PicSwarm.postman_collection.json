						"body": {
							"mode": "raw",
							"raw": "{\n    \"currentPassword\": \"123456\",\n    \"newPassword\": \"newpassword123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/password",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", "password"]
						},
						"description": "Change user password"
					}
				},
				{
					"name": "Update Profile Picture",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"profilePicture\": \"https://example.com/profile.jpg\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/profile-picture",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", "profile-picture"]
						},
						"description": "Update profile picture URL"
					}
				}
			]
		},
